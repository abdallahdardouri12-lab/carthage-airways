<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkWindow" id="login_window">
    <property name="can-focus">False</property>
    <property name="title">Carthage Airways - Connexion</property>
    <property name="default-width">820</property>
    <property name="default-height">500</property>
    <property name="resizable">False</property>
    <property name="window-position">center</property>
    <signal name="destroy" handler="gtk_main_quit" swapped="no"/>
    <child>
      <object class="GtkBox" id="box_racine">
        <property name="visible">True</property>
        <property name="orientation">horizontal</property>
        <property name="homogeneous">True</property>
        <child>
          <object class="GtkBox" id="panneau_gauche">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <style><class name="panneau-gauche"/></style>
            <child>
              <object class="GtkBox" id="contenu_gauche">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="valign">center</property>
                <property name="vexpand">True</property>
                <property name="margin-start">36</property>
                <property name="margin-end">36</property>
                <child>
                  <object class="GtkLabel" id="lbl_marque">
                    <property name="visible">True</property>
                    <property name="label">Carthage Airways</property>
                    <property name="xalign">0</property>
                    <style><class name="marque"/></style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_slogan">
                    <property name="visible">True</property>
                    <property name="label">Le ciel de la Méditerranée,
à portée de clic.</property>
                    <property name="xalign">0</property>
                    <style><class name="slogan"/></style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="panneau_droit">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="valign">center</property>
            <property name="margin-start">44</property>
            <property name="margin-end">44</property>
            <style><class name="panneau-droit"/></style>
            <child>
              <object class="GtkLabel" id="lbl_icone">
                <property name="visible">True</property>
                <property name="label">✈</property>
                <style><class name="icone"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_titre">
                <property name="visible">True</property>
                <property name="label">Bienvenue à bord</property>
                <property name="xalign">0</property>
                <property name="margin-top">8</property>
                <style><class name="titre"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_sous_titre">
                <property name="visible">True</property>
                <property name="label">Connectez-vous pour accéder à votre espace.</property>
                <property name="xalign">0</property>
                <property name="margin-bottom">10</property>
                <style><class name="sous-titre"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_login">
                <property name="visible">True</property>
                <property name="label">Identifiant</property>
                <property name="xalign">0</property>
                <style><class name="champ-label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="entry_login">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="placeholder-text">Votre identifiant</property>
                <signal name="activate" handler="on_entry_login_activate" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_password">
                <property name="visible">True</property>
                <property name="label">Mot de passe</property>
                <property name="xalign">0</property>
                <property name="margin-top">6</property>
                <style><class name="champ-label"/></style>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="entry_password">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="visibility">False</property>
                <property name="invisible-char">•</property>
                <property name="placeholder-text">Votre mot de passe</property>
                <signal name="activate" handler="on_btn_connecter_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_connecter">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label">Se connecter</property>
                <property name="margin-top">14</property>
                <signal name="clicked" handler="on_btn_connecter_clicked" swapped="no"/>
                <style><class name="bouton-principal"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_erreur">
                <property name="visible">True</property>
                <property name="label"></property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="margin-top">4</property>
                <style><class name="erreur"/></style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_pied">
                <property name="visible">True</property>
                <property name="label">Projet Programmation C · ESPRIT · 2P/3B · 2026-2027</property>
                <property name="margin-top">12</property>
                <style><class name="pied"/></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
